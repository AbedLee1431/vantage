// Prisma schema for Vantage — Phase 1 (Foundation).
//
// Identity + tenancy + catalog + monitoring core. Billing (Plan/Subscription/UsageRecord),
// AI (AiAnalysis/AiConversation), reports, and jobs arrive with their phases — see
// docs/Database.md. Every tenant-owned model carries organizationId (ADR: server-side isolation).

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ── Identity & tenancy ──────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  resetTokens PasswordResetToken[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  stores       Store[]
  products     Product[]
  advertisers  Advertiser[]
  ads          Ad[]
  landingPages LandingPage[]
  reviews      Review[]
  competitors  Competitor[]
  watchlists   Watchlist[]
  watchlistItems WatchlistItem[]
  changeEvents ChangeEvent[]
  aiAnalyses   AiAnalysis[]
  aiConversations AiConversation[]
  aiMessages     AiMessage[]
  jobs         Job[]
  opportunities Opportunity[]
  alerts       Alert[]
  syncState    SyncState?
  reports      Report[]
  subscription Subscription?
  usageRecords UsageRecord[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(member)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// DB-backed rate-limit counters (ADR-011: Postgres, never in-memory).
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime
}

// ── Catalog (tenant-owned, provenance-labeled) ──────────────────────────────

model Store {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  domain         String
  category       String
  country        String
  platform       String
  description    String?
  provenance     Provenance
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
  advertisers  Advertiser[]
  ads          Ad[]
  landingPages LandingPage[]
  reviews      Review[]
  competitors  Competitor[]

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([organizationId, category])
}

model Product {
  id             String     @id @default(cuid())
  organizationId String
  storeId        String
  name           String
  category       String
  description    String?
  price          Decimal    @db.Decimal(12, 2)
  currency       String     @default("USD")
  url            String
  imageUrl       String?
  tags           String[]
  firstSeen      DateTime
  lastSeen       DateTime
  provenance     Provenance
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reviews      Review[]

  @@unique([organizationId, url])
  @@index([organizationId])
  @@index([storeId])
  @@index([organizationId, category])
}

model Advertiser {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  storeId        String?
  platform       String
  provenance     Provenance
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  ads          Ad[]

  @@unique([organizationId, name, platform])
  @@index([organizationId])
  @@index([storeId])
}

model Ad {
  id             String     @id @default(cuid())
  organizationId String
  advertiserId   String
  storeId        String?
  platform       String
  title          String
  primaryText    String?
  headline       String?
  cta            String?
  creativeUrl    String?
  destinationUrl String?
  format         String
  firstSeen      DateTime
  lastSeen       DateTime
  // Whole days between firstSeen and lastSeen, computed by the seeder/sync.
  // Stored (not computed on read) so duration is filterable/sortable in the DB.
  durationDays   Int        @default(0)
  status         String     @default("active")
  provenance     Provenance
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  advertiser   Advertiser   @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([advertiserId])
  @@index([storeId])
  @@index([organizationId, platform])
  @@index([organizationId, status])
}

model LandingPage {
  id             String     @id @default(cuid())
  organizationId String
  storeId        String
  url            String
  title          String?
  firstSeen      DateTime
  lastSeen       DateTime
  provenance     Provenance
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, storeId, url])
  @@index([organizationId])
  @@index([storeId])
}

model Review {
  id             String     @id @default(cuid())
  organizationId String
  productId      String?
  storeId        String?
  author         String?
  rating         Int
  title          String?
  body           String
  date           DateTime
  source         String
  provenance     Provenance
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@index([storeId])
}

// ── Monitoring core (tenant-owned) ──────────────────────────────────────────

model Competitor {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  alias          String?
  addedAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, storeId])
  @@index([organizationId])
}

model Watchlist {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        WatchlistItem[]

  @@index([organizationId])
}

model WatchlistItem {
  id             String   @id @default(cuid())
  watchlistId    String
  organizationId String
  itemType       ItemType
  refId          String
  addedAt        DateTime @default(now())

  watchlist    Watchlist    @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([watchlistId])
  @@index([watchlistId, itemType])
  @@index([organizationId])
}

model ChangeEvent {
  id             String          @id @default(cuid())
  organizationId String
  itemType       ItemType
  refId          String
  type           ChangeEventType
  summary        String
  before         Json?
  after          Json?
  detectedAt     DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alert        Alert?

  @@index([organizationId])
  @@index([organizationId, detectedAt])
  @@index([organizationId, type])
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  owner
  member
}

enum Provenance {
  demo
  mock
  estimated
  calculated
  external
  ai
  user
}

enum ItemType {
  product
  store
  advertiser
  competitor
  ad
  review
}

enum ChangeEventType {
  new_product
  removed_product
  new_ad
  ad_activity_change
  price_change
  landing_page_change
  review_change
}

// ── AI intelligence (tenant-owned, Phase 4) ─────────────────────────────────

model AiAnalysis {
  id             String         @id @default(cuid())
  organizationId String
  kind           AiAnalysisKind
  targetRef      String
  promptHash     String
  result         Json
  evidence       Json
  provider       String
  model          String
  provenance     Provenance
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, kind, targetRef])
  @@index([organizationId, promptHash])
}

model AiConversation {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@index([organizationId])
  @@index([organizationId, updatedAt])
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  organizationId String
  role           AiMessageRole
  content        String        @db.Text
  toolCalls      Json?
  evidence       Json?
  provenance     Provenance
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([organizationId])
}

model Job {
  id             String    @id @default(cuid())
  organizationId String
  type           JobType
  status         JobStatus @default(queued)
  payload        Json
  resultId       String?
  error          String?
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type, status])
}

enum AiAnalysisKind {
  ad
  competitor
  review_summary
}

enum AiMessageRole {
  user
  assistant
}

enum JobType {
  ad_analysis
  competitor_analysis
  review_summary
  opportunity_analysis
  catalog_sync
  report_generation
}

enum JobStatus {
  queued
  running
  done
  failed
}

// ── Market opportunities (tenant-owned, Phase 5) ────────────────────────────

model Opportunity {
  id             String               @id @default(cuid())
  organizationId String
  title          String
  description    String               @db.Text
  evidence       Json
  supportingData Json
  competitors    Json
  painPoints     Json
  differentiation String              @db.Text
  confidence     OpportunityConfidence
  status         OpportunityStatus    @default(open)
  provider       String
  model          String
  provenance     Provenance
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, confidence])
}

enum OpportunityConfidence {
  low
  medium
  high
}

enum OpportunityStatus {
  open
  archived
}

// ── Monitoring alerts (tenant-owned, Phase 6) ───────────────────────────────

model Alert {
  id             String        @id @default(cuid())
  organizationId String
  changeEventId  String        @unique
  severity       AlertSeverity
  acknowledgedAt DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changeEvent  ChangeEvent  @relation(fields: [changeEventId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, acknowledgedAt])
}

enum AlertSeverity {
  low
  medium
  high
}

// ── Sync state (tenant-owned, Phase 6) ──────────────────────────────────────
// Explicit per-org detection baseline. Set at seed/provision time (covering all
// seed rows) and advanced on every completed sync. Without this, firstSeen and
// createdAt timestamps alone cannot distinguish baseline rows from new ones.

model SyncState {
  organizationId String   @id
  lastSyncAt     DateTime
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ── Reports (tenant-owned, Phase 7) ─────────────────────────────────────────
// Point-in-time snapshots (never cached/deduped — each generation is history).
// Sections embed frozen data; CSV exports serialize the same snapshot.

model Report {
  id             String       @id @default(cuid())
  organizationId String
  type           ReportType
  title          String
  status         ReportStatus @default(queued)
  params         Json
  sections       Json?
  evidence       Json?
  provider       String?
  model          String?
  provenance     Provenance   @default(demo)
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
}

enum ReportType {
  competitor
  product
  advertising
  customer
  trends
  monitoring
  combined
}

enum ReportStatus {
  queued
  running
  done
  failed
}

// ── Billing (tenant-owned, Phase 8) ───────────────────────────────────────────
// Plans live in centralized code config (src/lib/billing/plans.ts); the DB
// stores only per-org subscription state + monthly usage counters. Stripe is
// the system of record for payment details; webhooks are authoritative.

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  planCode             String             @default("free")
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  unpaid
  canceled
  incomplete
  incomplete_expired
}

model UsageRecord {
  id             String      @id @default(cuid())
  organizationId String
  action         UsageAction
  period         String // Calendar month "YYYY-MM"; new row per month = automatic reset.
  count          Int         @default(0)
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, action, period])
  @@index([organizationId])
}

enum UsageAction {
  search
  ai_analysis
  competitor_analysis
  report_generation
}

// Stripe webhook idempotency ledger (global, NOT tenant-scoped — webhooks carry
// no session; org is resolved from the event payload after verification).
model StripeWebhookEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())

  @@index([type])
}
