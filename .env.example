# ──────────────────────────────────────────────────────────────────────────
# Vantage — environment variable template
# Copy to .env and fill in. NEVER commit .env files with secrets.
# The application runs fully on demo data when optional keys are absent.
# See docs/Integrations.md for the live-vs-demo matrix.
# ──────────────────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL). Local dev example uses the docker-compose Postgres service.
# Start Docker Desktop first, then: docker compose up -d postgres
DATABASE_URL=postgresql://vantage:vantage@localhost:5432/vantage?schema=public

# Authentication (Auth.js). Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional in development: https://authjs.dev/reference/core/errors#missingsecret
AUTH_TRUST_HOST=true

# ── AI provider (OPTIONAL) ──────────────────────────────────────────────────
# If AI_* are unset, AI features run in a clearly labeled Demo AI mode.
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, local servers).
AI_PROVIDER=demo            # demo | openai-compatible
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Optional tuning (defaults shown):
# AI_TIMEOUT_MS=30000
# AI_MAX_TOKENS=2000

# Cron secret for cross-org job processing (Phase 10 production cron).
# CRON_SECRET=

# ── Stripe billing (OPTIONAL for local dev) ──────────────────────────────
# Without these keys the app runs in demo billing mode (Free plan, fully usable).
# Set test-mode keys to enable Pro checkout + webhooks. Webhook signing is
# verified server-side; the publishable key is reserved for future client use.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ── Data providers (OPTIONAL) ──────────────────────────────────────────────
# No external data providers are implemented for the MVP; demo data is used.
# Interfaces and this namespace are reserved for future live providers.
# DATA_PROVIDER_PRODUCT=
# DATA_PROVIDER_STORE=
# DATA_PROVIDER_ADVERTISING=
# DATA_PROVIDER_REVIEW=
